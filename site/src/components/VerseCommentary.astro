---
interface WordStudy {
  term_english: string;
  term_original: string;
  transliteration?: string;
  meaning: string;
  significance: string;
}

interface CrossRef {
  reference: string;
  connection: string;
}

interface PropheticQuote {
  speaker: string;
  talk_title: string;
  date: string;
  quote_or_paraphrase: string;
}

interface RestorationLens {
  jst_changes?: string;
  bom_parallels?: string;
  dc_connections?: string;
  temple_connections?: string;
}

interface TcrKeyTerm {
  hebrew: string;
  transliteration: string;
  rendered_as: string;
  semantic_range: string;
  note: string;
}

interface TcrVerse {
  verse: number;
  text_hebrew: string;
  text_kjv: string;
  rendering: string;
  expanded_rendering?: string;
  translator_notes?: string[];
  key_terms?: TcrKeyTerm[];
  reading_level?: string;
}

interface DssVerse {
  verse: number;
  has_variant?: boolean;
  significance?: string;
  mt_reading?: string;
  dss_reading?: string;
  mt_rendering?: string;
  variant_rendering?: string;
  manuscript_reference?: string;
  variant_notes?: string[];
}

interface Props {
  book: string;
  chapter: number;
  verse: number;
  text_kjv: string;
  text_jst?: string | null;
  tcr?: TcrVerse | null;
  dss?: DssVerse | null;
  commentary: {
    narrative: string;
    word_study?: WordStudy[];
    cross_references?: CrossRef[];
    historical_context?: string;
    restoration_lens?: RestorationLens;
    prophetic_quotes?: PropheticQuote[];
    christological_typology?: string;
    application?: string;
  };
}

const { book, chapter, verse, text_kjv, text_jst, tcr, dss, commentary } = Astro.props;
const c = commentary;
const ref = `${book} ${chapter}:${verse}`;
// Only surface DSS blocks when there is something substantive to show — either
// a distinct rendering vs the MT, notes explaining the variant, or a
// significance level of "theological" (variant matters even when the
// English renderings coincide).
const dssMeaningful = dss && (
  (dss.variant_rendering && dss.mt_rendering && dss.variant_rendering !== dss.mt_rendering) ||
  (dss.variant_notes && dss.variant_notes.length > 0) ||
  dss.significance === 'theological'
);
---

<article id={`v${verse}`} class="mb-10 scroll-mt-20">
  <h3 class="font-sans text-gold font-semibold text-xl mb-3">{ref}</h3>

  <div class="mb-5 space-y-3">
    {/* KJV — always shown */}
    <div class="pl-4" style="border-left:3px solid var(--color-gold);">
      <p class="font-sans text-[10px] font-bold uppercase tracking-widest mb-1" style="color:var(--color-gold);opacity:.7;">KJV</p>
      <blockquote class="verse-text text-text/90">
        {text_kjv}
      </blockquote>
    </div>

    {/* JST — shown when a JST revision exists */}
    {text_jst && (
      <div class="pl-4" style="border-left:3px solid #5b9bd5;">
        <p class="font-sans text-[10px] font-bold uppercase tracking-widest mb-1" style="color:#5b9bd5;">JST</p>
        <blockquote class="verse-text text-text/90" style="font-style:italic;">
          {text_jst}
        </blockquote>
      </div>
    )}

    {/* TCR — shown when The Covenant Rendering exists for this verse */}
    {tcr && (
      <div class="pl-4" style="border-left:3px solid #6db89e;">
        <p class="font-sans text-[10px] font-bold uppercase tracking-widest mb-1">
          <a href="https://thecovenantrendering.com" target="_blank" rel="noopener" style="color:#6db89e;text-decoration:none;">TCR</a>
        </p>
        <blockquote class="verse-text text-text/90">
          {tcr.rendering}
        </blockquote>

        {tcr.expanded_rendering && (
          <p class="text-sm leading-relaxed mt-2 pl-1" style="color:var(--color-text-muted);font-style:italic;">
            {tcr.expanded_rendering}
          </p>
        )}

        {tcr.key_terms && tcr.key_terms.length > 0 && (
          <div class="space-y-1.5 mt-2">
            {tcr.key_terms.map((kt: TcrKeyTerm) => (
              <div class="text-sm">
                <span class="font-sans font-semibold" style="color:#6db89e;">{kt.rendered_as}</span>
                <span class="font-sans text-xs ml-1.5" style="color:var(--color-text-muted);">{kt.hebrew} · {kt.transliteration}</span>
                <span class="text-xs" style="color:var(--color-text-muted);"> — {kt.note}</span>
              </div>
            ))}
          </div>
        )}

        {tcr.translator_notes && tcr.translator_notes.length > 0 && (
          <details class="mt-2 text-sm">
            <summary class="font-sans font-medium flex items-center gap-1.5 cursor-pointer" style="color:var(--color-text-muted);font-size:.75rem;">
              <span class="chevron text-xs">&#9654;</span> Translator Notes
            </summary>
            <ul class="mt-1.5 space-y-1 list-none">
              {tcr.translator_notes.map((note: string) => (
                <li class="flex gap-2 text-xs" style="color:var(--color-text-muted);">
                  <span style="color:#6db89e;margin-top:.15rem;font-size:.5rem;">&#9670;</span>
                  <span>{note}</span>
                </li>
              ))}
            </ul>
          </details>
        )}
      </div>
    )}

    {/* DSS — Dead Sea Scrolls variant, shown when meaningful */}
    {dssMeaningful && (
      <div class="pl-4" style="border-left:3px solid #c8a97b;">
        <p class="font-sans text-[10px] font-bold uppercase tracking-widest mb-1 flex items-center gap-2">
          <span title="Dead Sea Scrolls — Great Isaiah Scroll (1QIsaᵃ), c. 125 BCE" style="color:#c8a97b;">DSS</span>
          {dss?.significance && (
            <span
              class="font-sans font-normal normal-case tracking-normal text-[10px] px-1.5 py-0.5 rounded"
              style={`color:#c8a97b;background:rgba(200,169,123,.12);letter-spacing:.02em;`}
            >
              {dss.significance} variant
            </span>
          )}
        </p>

        {dss?.variant_rendering && dss.mt_rendering && dss.variant_rendering !== dss.mt_rendering && (
          <div class="space-y-1.5">
            <div class="text-sm">
              <span class="font-sans text-xs uppercase tracking-wider mr-1.5" style="color:var(--color-text-muted);opacity:.7;">MT</span>
              <span style="color:var(--color-text-muted);">"{dss.mt_rendering}"</span>
            </div>
            <blockquote class="verse-text text-text/90">
              "{dss.variant_rendering}"
            </blockquote>
          </div>
        )}

        {dss?.variant_rendering && (!dss.mt_rendering || dss.variant_rendering === dss.mt_rendering) && (
          <blockquote class="verse-text text-text/90">
            "{dss.variant_rendering}"
          </blockquote>
        )}

        {dss?.mt_reading && dss?.dss_reading && (
          <div class="mt-2 text-xs" style="color:var(--color-text-muted);font-family:'Cormorant Garamond',Georgia,serif;">
            <div><span style="opacity:.6;">MT:</span> <span dir="rtl" lang="he">{dss.mt_reading}</span></div>
            <div><span style="opacity:.6;">DSS:</span> <span dir="rtl" lang="he">{dss.dss_reading}</span></div>
          </div>
        )}

        {dss?.manuscript_reference && (
          <p class="font-sans text-[10px] mt-1.5" style="color:var(--color-text-muted);opacity:.65;">
            {dss.manuscript_reference}
          </p>
        )}

        {dss?.variant_notes && dss.variant_notes.length > 0 && (
          <details class="mt-2 text-sm">
            <summary class="font-sans font-medium flex items-center gap-1.5 cursor-pointer" style="color:var(--color-text-muted);font-size:.75rem;">
              <span class="chevron text-xs">&#9654;</span> Scroll Notes
            </summary>
            <ul class="mt-1.5 space-y-1 list-none">
              {dss.variant_notes.map((note: string) => (
                <li class="flex gap-2 text-xs" style="color:var(--color-text-muted);">
                  <span style="color:#c8a97b;margin-top:.15rem;font-size:.5rem;">&#9670;</span>
                  <span>{note}</span>
                </li>
              ))}
            </ul>
          </details>
        )}
      </div>
    )}
  </div>

  {c.narrative && (
    <div class="text-text/85 mb-5 whitespace-pre-line">
      {c.narrative}
    </div>
  )}

  {c.word_study && c.word_study.length > 0 && (
    <details class="mb-3 bg-expand-bg rounded-lg">
      <summary class="px-4 py-3 font-sans font-medium text-gold-light flex items-center gap-2">
        <span class="chevron text-xs">&#9654;</span> Word Study
      </summary>
      <div class="px-4 pb-4 space-y-3">
        {c.word_study.map((w: WordStudy) => (
          <div>
            <span class="font-semibold text-gold">{w.term_english}</span>
            {w.term_original && <span class="text-text-muted ml-1">({w.term_original})</span>}
            {w.transliteration && <span class="text-text-muted ml-1 italic">— {w.transliteration}</span>}
            <p class="text-text/75 mt-1">{w.meaning}</p>
            {w.significance && <p class="text-text/65 mt-1">{w.significance}</p>}
          </div>
        ))}
      </div>
    </details>
  )}

  {c.cross_references && c.cross_references.length > 0 && (
    <details class="mb-3 bg-expand-bg rounded-lg">
      <summary class="px-4 py-3 font-sans font-medium text-gold-light flex items-center gap-2">
        <span class="chevron text-xs">&#9654;</span> Cross-References
      </summary>
      <div class="px-4 pb-4 space-y-2">
        {c.cross_references.map((r: CrossRef) => (
          <div>
            <span class="font-semibold text-gold">{r.reference}</span>
            <span class="text-text/70 ml-1">— {r.connection}</span>
          </div>
        ))}
      </div>
    </details>
  )}

  {c.historical_context && (
    <details class="mb-3 bg-expand-bg rounded-lg">
      <summary class="px-4 py-3 font-sans font-medium text-gold-light flex items-center gap-2">
        <span class="chevron text-xs">&#9654;</span> Historical &amp; Cultural Context
      </summary>
      <div class="px-4 pb-4 text-text/75 leading-relaxed whitespace-pre-line">
        {c.historical_context}
      </div>
    </details>
  )}

  {c.restoration_lens && (
    <details class="mb-3 bg-expand-bg rounded-lg">
      <summary class="px-4 py-3 font-sans font-medium text-gold-light flex items-center gap-2">
        <span class="chevron text-xs">&#9654;</span> Restoration Lens
      </summary>
      <div class="px-4 pb-4 space-y-2 text-text/75 leading-relaxed">
        {c.restoration_lens.jst_changes && (
          <div><span class="font-semibold text-gold text-xs uppercase">JST:</span> <span class="whitespace-pre-line">{c.restoration_lens.jst_changes}</span></div>
        )}
        {c.restoration_lens.bom_parallels && (
          <div><span class="font-semibold text-gold text-xs uppercase">Book of Mormon:</span> <span class="whitespace-pre-line">{c.restoration_lens.bom_parallels}</span></div>
        )}
        {c.restoration_lens.dc_connections && (
          <div><span class="font-semibold text-gold text-xs uppercase">D&amp;C:</span> <span class="whitespace-pre-line">{c.restoration_lens.dc_connections}</span></div>
        )}
        {c.restoration_lens.temple_connections && (
          <div><span class="font-semibold text-gold text-xs uppercase">Temple:</span> <span class="whitespace-pre-line">{c.restoration_lens.temple_connections}</span></div>
        )}
      </div>
    </details>
  )}

  {c.prophetic_quotes && c.prophetic_quotes.length > 0 && (
    <details class="mb-3 bg-expand-bg rounded-lg">
      <summary class="px-4 py-3 font-sans font-medium text-gold-light flex items-center gap-2">
        <span class="chevron text-xs">&#9654;</span> From the Prophets
      </summary>
      <div class="px-4 pb-4 space-y-3">
        {c.prophetic_quotes.map((q: PropheticQuote) => (
          <blockquote class="border-l-2 border-gold/40 pl-3">
            <p class="text-text/75 italic">"{q.quote_or_paraphrase}"</p>
            <p class="text-text-muted text-sm mt-1">— {q.speaker}{q.talk_title ? `, "${q.talk_title}"` : ''}{q.date ? ` (${q.date})` : ''}</p>
          </blockquote>
        ))}
      </div>
    </details>
  )}

  {c.christological_typology && (
    <details class="mb-3 bg-expand-bg rounded-lg">
      <summary class="px-4 py-3 font-sans font-medium text-gold-light flex items-center gap-2">
        <span class="chevron text-xs">&#9654;</span> Pointing to Christ
      </summary>
      <div class="px-4 pb-4 text-text/75 leading-relaxed whitespace-pre-line">
        {c.christological_typology}
      </div>
    </details>
  )}

  {c.application && (
    <details class="mb-3 bg-expand-bg rounded-lg">
      <summary class="px-4 py-3 font-sans font-medium text-gold-light flex items-center gap-2">
        <span class="chevron text-xs">&#9654;</span> Application
      </summary>
      <div class="px-4 pb-4 text-text/75 leading-relaxed whitespace-pre-line">
        {c.application}
      </div>
    </details>
  )}

  <hr class="border-navy-lighter mt-6" />
</article>
