---
interface WordStudy {
  term_english: string;
  term_original: string;
  transliteration?: string;
  meaning: string;
  significance: string;
}

interface CrossRef {
  reference: string;
  connection: string;
}

interface PropheticQuote {
  speaker: string;
  talk_title: string;
  date: string;
  quote_or_paraphrase: string;
}

interface RestorationLens {
  jst_changes?: string;
  bom_parallels?: string;
  dc_connections?: string;
  temple_connections?: string;
}

interface TcrKeyTerm {
  hebrew: string;
  transliteration: string;
  rendered_as: string;
  semantic_range: string;
  note: string;
}

interface TcrVerse {
  verse: number;
  text_hebrew: string;
  text_kjv: string;
  rendering: string;
  expanded_rendering?: string;
  translator_notes?: string[];
  key_terms?: TcrKeyTerm[];
  reading_level?: string;
}

interface DssVerse {
  verse: number;
  has_variant?: boolean;
  significance?: string;
  mt_reading?: string;
  dss_reading?: string;
  mt_rendering?: string;
  variant_rendering?: string;
  manuscript_reference?: string;
  variant_notes?: string[];
}

interface Props {
  book: string;
  chapter: number;
  verse: number;
  text_kjv: string;
  text_jst?: string | null;
  tcr?: TcrVerse | null;
  dss?: DssVerse | null;
  commentary: {
    narrative: string;
    word_study?: WordStudy[];
    cross_references?: CrossRef[];
    historical_context?: string;
    restoration_lens?: RestorationLens;
    prophetic_quotes?: PropheticQuote[];
    christological_typology?: string;
    application?: string;
  };
}

const { book, chapter, verse, text_kjv, text_jst, tcr, dss, commentary } = Astro.props;
const c = commentary;
const ref = `${book} ${chapter}:${verse}`;
// Only surface DSS blocks when there is something substantive to show — either
// a distinct rendering vs the MT, notes explaining the variant, or a
// significance level of "theological" (variant matters even when the
// English renderings coincide).
const dssMeaningful = dss && (
  (dss.variant_rendering && dss.mt_rendering && dss.variant_rendering !== dss.mt_rendering) ||
  (dss.variant_notes && dss.variant_notes.length > 0) ||
  dss.significance === 'theological'
);
---

<article id={`v${verse}`} class="verse-commentary mb-12 scroll-mt-20">
  <h3 class="font-sans text-gold font-semibold text-xl mb-3">{ref}</h3>

  <div class="scripture-stack mb-6 flex flex-col">
    {/* KJV — always shown */}
    <div class="scripture-source" style="border-left-color:var(--color-gold);">
      <p class="source-label" style="color:var(--color-gold);">KJV</p>
      <blockquote class="verse-text">
        {text_kjv}
      </blockquote>
    </div>

    {/* JST — shown when a JST revision exists */}
    {text_jst && (
      <div class="scripture-source" style="border-left-color:#3677ad;">
        <p class="source-label" style="color:#28618f;">JST</p>
        <blockquote class="verse-text">
          {text_jst}
        </blockquote>
      </div>
    )}

    {/* TCR — shown when The Covenant Rendering exists for this verse */}
    {tcr && (
      <div class="scripture-source" style="border-left-color:#40866f;">
        <p class="source-label">
          <a href="https://thecovenantrendering.com" target="_blank" rel="noopener" style="color:#286c57;text-decoration:none;">TCR</a>
        </p>
        <blockquote class="verse-text">
          {tcr.rendering}
        </blockquote>

        {tcr.expanded_rendering && (
          <p class="translation-detail mt-3">
            {tcr.expanded_rendering}
          </p>
        )}

        {tcr.key_terms && tcr.key_terms.length > 0 && (
          <div class="space-y-1.5 mt-2">
            {tcr.key_terms.map((kt: TcrKeyTerm) => (
              <div class="translation-note">
                <span class="font-sans font-semibold" style="color:#286c57;">{kt.rendered_as}</span>
                <span class="font-sans ml-1.5">{kt.hebrew} · {kt.transliteration}</span>
                <span> — {kt.note}</span>
              </div>
            ))}
          </div>
        )}

        {tcr.translator_notes && tcr.translator_notes.length > 0 && (
          <details class="mt-3">
            <summary class="translation-note font-sans font-semibold flex items-center gap-1.5 cursor-pointer">
              <span class="chevron text-xs">&#9654;</span> Translator Notes
            </summary>
            <ul class="mt-2 space-y-1.5 list-none">
              {tcr.translator_notes.map((note: string) => (
                <li class="translation-note flex gap-2">
                  <span style="color:#40866f;margin-top:.15rem;font-size:.55rem;">&#9670;</span>
                  <span>{note}</span>
                </li>
              ))}
            </ul>
          </details>
        )}
      </div>
    )}

    {/* DSS — Dead Sea Scrolls variant, shown when meaningful */}
    {dssMeaningful && (
      <div class="scripture-source" style="border-left-color:#9a6e31;">
        <p class="source-label flex items-center gap-2">
          <span title="Dead Sea Scrolls — Great Isaiah Scroll (1QIsaᵃ), c. 125 BCE" style="color:#76551a;">DSS</span>
          {dss?.significance && (
            <span
              class="font-sans font-semibold normal-case tracking-normal text-xs px-2 py-0.5 rounded"
              style={`color:#76551a;background:rgba(118,85,26,.10);letter-spacing:.01em;`}
            >
              {dss.significance} variant
            </span>
          )}
        </p>

        {dss?.variant_rendering && dss.mt_rendering && dss.variant_rendering !== dss.mt_rendering && (
          <div class="space-y-1.5">
            <div class="translation-detail">
              <span class="font-sans text-sm font-semibold uppercase tracking-wider mr-1.5" style="color:var(--color-text-2);">MT</span>
              <span>"{dss.mt_rendering}"</span>
            </div>
            <blockquote class="verse-text">
              "{dss.variant_rendering}"
            </blockquote>
          </div>
        )}

        {dss?.variant_rendering && (!dss.mt_rendering || dss.variant_rendering === dss.mt_rendering) && (
          <blockquote class="verse-text">
            "{dss.variant_rendering}"
          </blockquote>
        )}

        {dss?.mt_reading && dss?.dss_reading && (
          <div class="translation-note mt-3" style="font-family:Georgia,'Times New Roman',serif;">
            <div><strong>MT:</strong> <span dir="rtl" lang="he">{dss.mt_reading}</span></div>
            <div><strong>DSS:</strong> <span dir="rtl" lang="he">{dss.dss_reading}</span></div>
          </div>
        )}

        {dss?.manuscript_reference && (
          <p class="translation-note font-sans mt-2">
            {dss.manuscript_reference}
          </p>
        )}

        {dss?.variant_notes && dss.variant_notes.length > 0 && (
          <details class="mt-3">
            <summary class="translation-note font-sans font-semibold flex items-center gap-1.5 cursor-pointer">
              <span class="chevron text-xs">&#9654;</span> Scroll Notes
            </summary>
            <ul class="mt-2 space-y-1.5 list-none">
              {dss.variant_notes.map((note: string) => (
                <li class="translation-note flex gap-2">
                  <span style="color:#9a6e31;margin-top:.15rem;font-size:.55rem;">&#9670;</span>
                  <span>{note}</span>
                </li>
              ))}
            </ul>
          </details>
        )}
      </div>
    )}
  </div>

  {c.narrative && (
    <div class="commentary-narrative mb-6 whitespace-pre-line">
      {c.narrative}
    </div>
  )}

  {c.word_study && c.word_study.length > 0 && (
    <details class="study-detail mb-3">
      <summary class="flex items-center gap-2">
        <span class="chevron text-xs">&#9654;</span> Word Study
      </summary>
      <div class="study-detail-content space-y-4">
        {c.word_study.map((w: WordStudy) => (
          <div>
            <span class="font-semibold text-gold">{w.term_english}</span>
            {w.term_original && <span class="secondary-copy ml-1">({w.term_original})</span>}
            {w.transliteration && <span class="secondary-copy ml-1 italic">— {w.transliteration}</span>}
            <p class="mt-1">{w.meaning}</p>
            {w.significance && <p class="secondary-copy mt-1">{w.significance}</p>}
          </div>
        ))}
      </div>
    </details>
  )}

  {c.cross_references && c.cross_references.length > 0 && (
    <details class="study-detail mb-3">
      <summary class="flex items-center gap-2">
        <span class="chevron text-xs">&#9654;</span> Cross-References
      </summary>
      <div class="study-detail-content space-y-3">
        {c.cross_references.map((r: CrossRef) => (
          <div>
            <span class="font-semibold text-gold">{r.reference}</span>
            <span class="ml-1">— {r.connection}</span>
          </div>
        ))}
      </div>
    </details>
  )}

  {c.historical_context && (
    <details class="study-detail mb-3">
      <summary class="flex items-center gap-2">
        <span class="chevron text-xs">&#9654;</span> Historical &amp; Cultural Context
      </summary>
      <div class="study-detail-content whitespace-pre-line">
        {c.historical_context}
      </div>
    </details>
  )}

  {c.restoration_lens && (
    <details class="study-detail mb-3">
      <summary class="flex items-center gap-2">
        <span class="chevron text-xs">&#9654;</span> Restoration Lens
      </summary>
      <div class="study-detail-content space-y-3">
        {c.restoration_lens.jst_changes && (
          <div><span class="font-semibold text-gold text-sm uppercase">JST:</span> <span class="whitespace-pre-line">{c.restoration_lens.jst_changes}</span></div>
        )}
        {c.restoration_lens.bom_parallels && (
          <div><span class="font-semibold text-gold text-sm uppercase">Book of Mormon:</span> <span class="whitespace-pre-line">{c.restoration_lens.bom_parallels}</span></div>
        )}
        {c.restoration_lens.dc_connections && (
          <div><span class="font-semibold text-gold text-sm uppercase">D&amp;C:</span> <span class="whitespace-pre-line">{c.restoration_lens.dc_connections}</span></div>
        )}
        {c.restoration_lens.temple_connections && (
          <div><span class="font-semibold text-gold text-sm uppercase">Temple:</span> <span class="whitespace-pre-line">{c.restoration_lens.temple_connections}</span></div>
        )}
      </div>
    </details>
  )}

  {c.prophetic_quotes && c.prophetic_quotes.length > 0 && (
    <details class="study-detail mb-3">
      <summary class="flex items-center gap-2">
        <span class="chevron text-xs">&#9654;</span> From the Prophets
      </summary>
      <div class="study-detail-content space-y-4">
        {c.prophetic_quotes.map((q: PropheticQuote) => (
          <blockquote class="border-l-2 border-gold/40 pl-3">
            <p class="italic">"{q.quote_or_paraphrase}"</p>
            <p class="secondary-copy text-base mt-2">— {q.speaker}{q.talk_title ? `, "${q.talk_title}"` : ''}{q.date ? ` (${q.date})` : ''}</p>
          </blockquote>
        ))}
      </div>
    </details>
  )}

  {c.christological_typology && (
    <details class="study-detail mb-3">
      <summary class="flex items-center gap-2">
        <span class="chevron text-xs">&#9654;</span> Pointing to Christ
      </summary>
      <div class="study-detail-content whitespace-pre-line">
        {c.christological_typology}
      </div>
    </details>
  )}

  {c.application && (
    <details class="study-detail mb-3">
      <summary class="flex items-center gap-2">
        <span class="chevron text-xs">&#9654;</span> Application
      </summary>
      <div class="study-detail-content whitespace-pre-line">
        {c.application}
      </div>
    </details>
  )}

  <hr class="border-navy-lighter mt-6" />
</article>
