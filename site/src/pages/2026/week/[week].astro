---
import Layout from '../../../layouts/Layout.astro';
import VerseCommentary from '../../../components/VerseCommentary.astro';
import { readFileSync, existsSync } from 'fs';
import { join } from 'path';

export function getStaticPaths() {
  const root = join(process.cwd(), '..');
  const schedule = JSON.parse(readFileSync(join(root, 'data', 'cfm_schedule.json'), 'utf-8'));
  return schedule.map((w: any) => ({ params: { week: String(w.week) } }));
}

const { week } = Astro.params;
const weekNum = parseInt(week!);
const root = join(process.cwd(), '..');
const schedule = JSON.parse(readFileSync(join(root, 'data', 'cfm_schedule.json'), 'utf-8'));
const weekData = schedule.find((w: any) => w.week === weekNum);

const weekDir = join(root, 'content', 'weeks', '2026', `week-${String(weekNum).padStart(2, '0')}`);
const commPath = join(weekDir, 'commentary.json');
const hasCommentary = existsSync(commPath);
const verses: any[] = hasCommentary ? JSON.parse(readFileSync(commPath, 'utf-8')) : [];

// Load TCR data for this week's chapters, keyed by "Book Chapter:Verse".
// Keep in sync with the slug_map in pipeline/generate_commentary.py.
const tcrSlugMap: Record<string, string> = {
  Genesis: 'genesis',
  Exodus: 'exodus',
  Leviticus: 'leviticus',
  Numbers: 'numbers',
  Deuteronomy: 'deuteronomy',
  Joshua: 'joshua',
  Judges: 'judges',
  Ruth: 'ruth',
  '1 Samuel': '1-samuel',
  '2 Samuel': '2-samuel',
  '1 Kings': '1-kings',
  '2 Kings': '2-kings',
  '1 Chronicles': '1-chronicles',
  '2 Chronicles': '2-chronicles',
  Ezra: 'ezra',
  Nehemiah: 'nehemiah',
  Esther: 'esther',
  Job: 'job',
  Psalms: 'psalms',
  Proverbs: 'proverbs',
  Ecclesiastes: 'ecclesiastes',
  'Song of Solomon': 'song-of-songs',
  'Song of Songs': 'song-of-songs',
  Isaiah: 'isaiah',
  Jeremiah: 'jeremiah',
  Lamentations: 'lamentations',
  Ezekiel: 'ezekiel',
  Daniel: 'daniel',
  Hosea: 'hosea',
  Joel: 'joel',
  Amos: 'amos',
  Obadiah: 'obadiah',
  Jonah: 'jonah',
  Micah: 'micah',
  Nahum: 'nahum',
  Habakkuk: 'habakkuk',
  Zephaniah: 'zephaniah',
  Haggai: 'haggai',
  Zechariah: 'zechariah',
  Malachi: 'malachi',
};
const tcrIndex: Record<string, any> = {};
if (weekData?.chapters) {
  for (const ch of weekData.chapters) {
    const slug = tcrSlugMap[ch.book];
    if (!slug) continue;
    const padded = String(ch.chapter).padStart(2, '0');
    const tcrPath = join(root, 'content', 'tcr', slug, `chapter-${padded}.json`);
    if (!existsSync(tcrPath)) continue;
    const tcrChapter = JSON.parse(readFileSync(tcrPath, 'utf-8'));
    for (const v of tcrChapter.verses) {
      tcrIndex[`${ch.book} ${ch.chapter}:${v.verse}`] = v;
    }
  }
}

// Load Dead Sea Scrolls data (currently Isaiah only via 1QIsa-a) using the
// same book -> slug pattern. Keep this map in sync with the pipeline-side
// slug_map in pipeline/generate_commentary.py::load_dss_chapter().
const dssSlugMap: Record<string, string> = {
  Isaiah: 'isaiah',
};
const dssIndex: Record<string, any> = {};
if (weekData?.chapters) {
  for (const ch of weekData.chapters) {
    const slug = dssSlugMap[ch.book];
    if (!slug) continue;
    const padded = String(ch.chapter).padStart(2, '0');
    const dssPath = join(root, 'content', 'dss', slug, `chapter-${padded}.json`);
    if (!existsSync(dssPath)) continue;
    const dssChapter = JSON.parse(readFileSync(dssPath, 'utf-8'));
    for (const v of dssChapter.verses ?? []) {
      dssIndex[`${ch.book} ${ch.chapter}:${v.verse}`] = v;
    }
  }
}

const overviewsPath = join(weekDir, 'chapter_overviews.json');
const overviews: Record<string, string> = existsSync(overviewsPath) ? JSON.parse(readFileSync(overviewsPath, 'utf-8')) : {};

const summaryPath = join(weekDir, 'week_summary.json');
const weekSummary: any = existsSync(summaryPath) ? JSON.parse(readFileSync(summaryPath, 'utf-8')) : null;

const creatorsPath = join(weekDir, 'creators.json');
const creators: any[] = existsSync(creatorsPath) ? JSON.parse(readFileSync(creatorsPath, 'utf-8')) : [];
const foundCreators = creators.filter((c: any) => c.found && c.content);

const chapters: Record<string, any[]> = {};
for (const v of verses) {
  const key = `${v.book} ${v.chapter}`;
  if (!chapters[key]) chapters[key] = [];
  chapters[key].push(v);
}

const prevWeek = weekNum > 1 ? weekNum - 1 : null;
const nextWeek = weekNum < 52 ? weekNum + 1 : null;
---

<Layout title={`Week ${weekNum}: ${weekData?.title ?? 'Unknown'}`}>
  <div id="top" class="mb-8">
    <div class="flex items-center justify-between mb-2 font-sans">
      {prevWeek ? (
        <a href={`/2026/week/${prevWeek}`} class="text-text-muted hover:text-gold text-sm transition-colors">&larr; Week {prevWeek}</a>
      ) : <span />}
      {nextWeek ? (
        <a href={`/2026/week/${nextWeek}`} class="text-text-muted hover:text-gold text-sm transition-colors">Week {nextWeek} &rarr;</a>
      ) : <span />}
    </div>

    <h1 class="font-sans text-3xl font-bold text-gold mb-1">Week {weekNum}: {weekData?.title}</h1>
    <p class="font-sans text-text-muted text-sm mb-1">
      {weekData?.date_start} to {weekData?.date_end}
    </p>
    <p class="font-sans text-lg text-text/80">{weekData?.scripture_block}</p>

    {weekData?.official_url && (
      <a
        href={weekData.official_url}
        target="_blank"
        rel="noopener"
        class="inline-block mt-3 text-sm font-sans text-gold/70 hover:text-gold transition-colors underline underline-offset-2"
      >
        Official Come, Follow Me Lesson &rarr;
      </a>
    )}
  </div>

  {!hasCommentary && weekSummary ? (
    <!-- Week Summary view (no verse-by-verse yet) -->
    <div class="space-y-8">
      {weekSummary.hook && (
        <blockquote style="border-left:3px solid var(--color-gold);padding:.85rem 1.25rem;background:var(--color-verse-bg);font-style:italic;font-family:'Cormorant Garamond',Georgia,serif;font-size:1.1rem;line-height:1.85;border-radius:0 .5rem .5rem 0;color:var(--color-text-2);">
          {weekSummary.hook}
        </blockquote>
      )}

      {weekSummary.overview && (
        <div>
          <h2 class="font-sans text-lg font-semibold mb-3" style="color:var(--color-gold)">Overview</h2>
          <div class="text-text/80 leading-relaxed whitespace-pre-line text-[15px]">{weekSummary.overview}</div>
        </div>
      )}

      {weekSummary.themes?.length > 0 && (
        <div>
          <h2 class="font-sans text-lg font-semibold mb-3" style="color:var(--color-gold)">Key Themes</h2>
          <ul class="space-y-1">
            {weekSummary.themes.map((t: string) => (
              <li class="flex items-start gap-2 text-[15px] text-text/80">
                <span style="color:var(--color-gold);margin-top:.25rem;font-size:.6rem;">✦</span> {t}
              </li>
            ))}
          </ul>
        </div>
      )}

      {weekSummary.key_verses?.length > 0 && (
        <div>
          <h2 class="font-sans text-lg font-semibold mb-4" style="color:var(--color-gold)">Key Verses</h2>
          <div class="space-y-5">
            {weekSummary.key_verses.map((kv: any) => (
              <div class="bg-navy-light rounded-xl p-5 border border-navy-lighter">
                <p class="font-sans text-xs font-semibold mb-1" style="color:var(--color-gold)">{kv.reference}</p>
                {kv.text_kjv && <blockquote class="verse-text text-sm mb-3">{kv.text_kjv}</blockquote>}
                <p class="text-text/75 text-sm leading-relaxed">{kv.insight}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      {weekSummary.restoration_lens && (
        <div>
          <h2 class="font-sans text-lg font-semibold mb-3" style="color:var(--color-gold)">Restoration Lens</h2>
          <div class="text-text/80 leading-relaxed whitespace-pre-line text-[15px]">{weekSummary.restoration_lens}</div>
        </div>
      )}

      {weekSummary.application && (
        <div>
          <h2 class="font-sans text-lg font-semibold mb-3" style="color:var(--color-gold)">Application</h2>
          <div class="text-text/80 leading-relaxed whitespace-pre-line text-[15px]">{weekSummary.application}</div>
        </div>
      )}

      <div class="mt-8 p-4 rounded-xl border border-navy-lighter bg-navy-light text-center">
        <p class="font-sans text-sm text-text-muted">Full verse-by-verse commentary for this week is coming in a future update.</p>
      </div>
    </div>
  ) : !hasCommentary ? (
    <div class="text-center py-16">
      <p class="text-text-muted text-lg font-sans">Commentary for this week hasn't been generated yet.</p>
      <p class="text-text-muted text-sm mt-2 font-sans">Check back soon — content is being produced weekly.</p>
    </div>
  ) : (
    <div>
      {/* Chapter navigation */}
      <nav class="mb-8 flex flex-wrap gap-2 font-sans">
        {Object.keys(chapters).map((ch) => (
          <a
            href={`#ch-${ch.replace(/\s/g, '-')}`}
            class="px-3 py-1.5 bg-navy-lighter rounded-lg text-sm text-text-muted hover:text-gold hover:bg-navy-light transition-colors"
          >
            {ch}
          </a>
        ))}
      </nav>

      {/* Verse-by-verse commentary */}
      {Object.entries(chapters).map(([chapterName, chapterVerses]) => (
        <section id={`ch-${chapterName.replace(/\s/g, '-')}`} class="mb-12 scroll-mt-16">
          <h2 class="font-sans text-2xl font-bold text-gold/90 mb-4 pb-2 border-b border-gold/20">
            {chapterName}
          </h2>
          {overviews[chapterName] && (
            <div class="bg-navy-light rounded-xl p-6 mb-8 border border-navy-lighter text-[15px] leading-[1.85] text-text/80 whitespace-pre-line">
              {overviews[chapterName]}
            </div>
          )}
          {chapterVerses
            .sort((a: any, b: any) => a.verse - b.verse)
            .map((v: any) => (
              <VerseCommentary
                {...v}
                tcr={tcrIndex[`${v.book} ${v.chapter}:${v.verse}`] ?? null}
                dss={dssIndex[`${v.book} ${v.chapter}:${v.verse}`] ?? null}
              />
            ))}

          {/* Per-chapter back to top */}
          <div class="flex items-center justify-between mt-2 mb-2">
            <div class="flex-1 h-px bg-navy-lighter/60"></div>
            <a
              href="#top"
              class="mx-4 flex items-center gap-1.5 font-sans text-xs text-text-muted hover:text-gold transition-colors group"
            >
              <svg class="w-3 h-3 group-hover:-translate-y-0.5 transition-transform" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="2,8 6,4 10,8" />
              </svg>
              Back to top
            </a>
            <div class="flex-1 h-px bg-navy-lighter/60"></div>
          </div>
        </section>
      ))}

      {/* Creator Roundup */}
      {foundCreators.length > 0 && (
        <section class="mt-16 mb-8">
          <h2 class="font-sans text-2xl font-bold text-gold/90 mb-6 pb-2 border-b border-gold/20">
            What Creators Are Saying This Week
          </h2>
          <div class="space-y-4">
            {foundCreators.map((creator: any) => (
              <a
                href={creator.content.url}
                target="_blank"
                rel="noopener"
                class="block bg-navy-light rounded-xl p-5 border border-navy-lighter hover:border-gold/30 transition-colors"
              >
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="font-sans text-gold font-semibold text-sm">{creator.source_name}</h3>
                    <p class="font-sans text-text/90 text-sm mt-1">{creator.content.title}</p>
                    <p class="text-text/60 text-xs mt-2 leading-relaxed">{creator.content.summary}</p>
                    {creator.content.hosts_or_guests && (
                      <p class="text-text-muted text-xs mt-1">Featuring: {creator.content.hosts_or_guests}</p>
                    )}
                  </div>
                  <div class="text-right shrink-0 font-sans">
                    <span class="text-xs text-gold/60 uppercase tracking-wider">{creator.content.content_type}</span>
                    {creator.content.duration_minutes && (
                      <p class="text-text-muted text-xs mt-1">{creator.content.duration_minutes} min</p>
                    )}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  )}

  <div class="flex items-center justify-between mt-12 font-sans">
    {prevWeek ? (
      <a href={`/2026/week/${prevWeek}`} class="text-text-muted hover:text-gold text-sm transition-colors">&larr; Week {prevWeek}</a>
    ) : <span />}
    {nextWeek ? (
      <a href={`/2026/week/${nextWeek}`} class="text-text-muted hover:text-gold text-sm transition-colors">Week {nextWeek} &rarr;</a>
    ) : <span />}
  </div>

  <!-- Floating back-to-top button -->
  <button
    id="float-top-btn"
    aria-label="Back to top"
    class="fixed bottom-6 right-6 z-50 w-10 h-10 rounded-full bg-navy-light border border-gold/30 text-gold/70 hover:text-gold hover:border-gold/60 shadow-lg transition-all duration-200 opacity-0 translate-y-2 pointer-events-none flex items-center justify-center"
  >
    <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="3,11 8,5 13,11" />
    </svg>
  </button>

  <script>
    // Floating back-to-top: show after scrolling 400px
    const btn = document.getElementById('float-top-btn');
    if (btn) {
      const toggle = () => {
        const show = window.scrollY > 400;
        btn.classList.toggle('opacity-0', !show);
        btn.classList.toggle('opacity-100', show);
        btn.classList.toggle('translate-y-2', !show);
        btn.classList.toggle('translate-y-0', show);
        btn.classList.toggle('pointer-events-none', !show);
      };
      window.addEventListener('scroll', toggle, { passive: true });
      btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    }

  </script>
</Layout>
