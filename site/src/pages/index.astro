---
import Layout from '../layouts/Layout.astro';
import { readFileSync, existsSync } from 'fs';
import { join } from 'path';

const root = join(process.cwd(), '..');
const schedule = JSON.parse(readFileSync(join(root, 'data', 'cfm_schedule.json'), 'utf-8'));

const today = new Date().toISOString().split('T')[0];

// Prefer the week that has content AND is closest/most relevant:
// 1. If today's week has content, use it
// 2. If the upcoming week has content (pipeline runs ahead), use that
// 3. Fall back to the week with the most recent content
const hasContentFor = (w: any) => {
  const dir = join(root, 'content', 'weeks', '2026', `week-${String(w.week).padStart(2, '0')}`);
  return existsSync(join(dir, 'commentary.json'));
};

const todayWeek = schedule.find((w: any) => today >= w.date_start && today <= w.date_end);
const nextWeek = todayWeek ? schedule.find((w: any) => w.week === todayWeek.week + 1) : null;

// Show upcoming week if it has content (pipeline runs a week ahead), else today, else first with content
const currentWeek =
  (nextWeek && hasContentFor(nextWeek) ? nextWeek : null) ??
  (todayWeek && hasContentFor(todayWeek) ? todayWeek : null) ??
  [...schedule].reverse().find(hasContentFor) ??
  schedule[8];

const currentWeekNum = currentWeek.week;

// Load hook + snippets for current week
const weekDir = join(root, 'content', 'weeks', '2026', `week-${String(currentWeekNum).padStart(2, '0')}`);
const hookPath = join(weekDir, 'hook.json');
const snippetsPath = join(weekDir, 'snippets.json');

const hookData = existsSync(hookPath) ? JSON.parse(readFileSync(hookPath, 'utf-8')) : null;
const snippetsData = existsSync(snippetsPath) ? JSON.parse(readFileSync(snippetsPath, 'utf-8')) : null;
const snippets: any[] = snippetsData?.snippets ?? [];

// Audio: use pre-generated MP3 if available, otherwise fall back to browser TTS
const audioUrl: string | null = hookData?.audio_url ?? null;
const hookText: string = hookData?.hook ?? '';

// Category labels + colors for snippet badges
const categoryMeta: Record<string, { label: string; color: string }> = {
  hebrew_insight:    { label: 'Hebrew',      color: 'bg-amber-900/40 text-amber-300 border-amber-700/40' },
  cross_reference:   { label: 'Cross-Ref',   color: 'bg-blue-900/40 text-blue-300 border-blue-700/40' },
  historical_context:{ label: 'History',     color: 'bg-stone-800/60 text-stone-300 border-stone-600/40' },
  restoration_lens:  { label: 'Restoration', color: 'bg-emerald-900/40 text-emerald-300 border-emerald-700/40' },
  application:       { label: 'Application', color: 'bg-purple-900/40 text-purple-300 border-purple-700/40' },
  prophetic:         { label: 'Prophetic',   color: 'bg-rose-900/40 text-rose-300 border-rose-700/40' },
  creator_highlight: { label: 'Creators',    color: 'bg-sky-900/40 text-sky-300 border-sky-700/40' },
};

// Past and upcoming weeks (excluding current)
const otherWeeks = schedule.filter((w: any) => w.week !== currentWeekNum);
const hasContent = (w: any) => {
  const dir = join(root, 'content', 'weeks', '2026', `week-${String(w.week).padStart(2, '0')}`);
  return existsSync(join(dir, 'commentary.json'));
};
---

<Layout title={`Week ${currentWeekNum}: ${currentWeek.title} | EveryVerseMatters`}>

  <!-- ── CURRENT WEEK FEATURED SECTION ── -->
  <div class="mb-16">
    <p class="font-sans text-xs uppercase tracking-widest text-gold/60 mb-3">This Week's Study</p>

    <div class="mb-1 flex flex-wrap items-baseline gap-3">
      <h1 class="font-sans text-3xl md:text-4xl font-bold text-gold leading-tight">
        Week {currentWeekNum}: {currentWeek.title}
      </h1>
    </div>
    <p class="font-sans text-sm text-text-muted mb-1">{currentWeek.date_start} — {currentWeek.date_end}</p>
    <p class="font-sans text-lg text-text/80 mb-2">{currentWeek.scripture_block}</p>
    <a
      href={currentWeek.official_url}
      target="_blank"
      rel="noopener"
      class="font-sans text-xs text-gold/50 hover:text-gold/80 transition-colors underline underline-offset-2"
    >
      Official Come, Follow Me Lesson &rarr;
    </a>

    <!-- Hook paragraph + audio player -->
    {hookData?.hook && (
      <div class="mt-6">
        <blockquote id="hook-text" class="border-l-2 border-gold/40 pl-5 py-1 text-text/90 text-base md:text-lg leading-relaxed italic font-serif">
          {hookData.hook}
        </blockquote>

        <!-- Audio play button -->
        <div class="mt-3 pl-5 flex items-center gap-3">
          <button
            id="audio-play-btn"
            aria-label="Listen to this week's introduction"
            class="group flex items-center gap-2 text-xs font-sans text-gold/60 hover:text-gold transition-colors"
          >
            <span id="audio-icon" class="flex items-center justify-center w-7 h-7 rounded-full border border-gold/30 group-hover:border-gold/60 transition-colors">
              <!-- Play icon -->
              <svg id="icon-play" class="w-3 h-3 ml-0.5 fill-current" viewBox="0 0 12 12">
                <polygon points="2,1 11,6 2,11" />
              </svg>
              <!-- Pause icon (hidden by default) -->
              <svg id="icon-pause" class="w-3 h-3 fill-current hidden" viewBox="0 0 12 12">
                <rect x="2" y="1" width="3" height="10" rx="0.5" />
                <rect x="7" y="1" width="3" height="10" rx="0.5" />
              </svg>
              <!-- Loading spinner (hidden by default) -->
              <svg id="icon-loading" class="w-3 h-3 animate-spin hidden" viewBox="0 0 12 12" fill="none">
                <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.5" stroke-dasharray="14 8" />
              </svg>
            </span>
            <span id="audio-label">Listen</span>
          </button>
          {audioUrl && (
            <span class="text-[10px] font-sans text-gold/30 uppercase tracking-wider">AI Voice</span>
          )}
        </div>

        {/* Hidden audio element for MP3 playback */}
        {audioUrl && <audio id="hook-audio" src={audioUrl} preload="none" />}
      </div>
    )}

    <!-- Two-column layout -->
    <div class="mt-8 grid md:grid-cols-2 gap-6">

      <!-- LEFT: Official Curriculum -->
      <div class="bg-navy-light rounded-2xl p-6 border border-navy-lighter">
        <p class="font-sans text-xs uppercase tracking-widest text-gold/50 mb-4">Official Curriculum</p>
        <h3 class="font-sans text-lg font-semibold text-gold mb-1">{currentWeek.title}</h3>
        <p class="font-sans text-sm text-text-muted mb-4">{currentWeek.scripture_block}</p>

        <div class="space-y-3 text-sm text-text/80 font-sans leading-relaxed">
          <div>
            <p class="text-gold/70 font-semibold text-xs uppercase tracking-wide mb-1">This Week's Theme</p>
            <p>The Abrahamic covenant moves from promise to fulfillment — from the impossible announcement of Isaac's birth to his binding on Mount Moriah. These chapters ask the defining question of covenant life: do we trust God enough to obey when we cannot see the end?</p>
          </div>
          <div>
            <p class="text-gold/70 font-semibold text-xs uppercase tracking-wide mb-1">Key Study Questions</p>
            <ul class="list-disc list-inside space-y-1 text-text/70">
              <li>What does Abraham's hospitality reveal about his relationship with God?</li>
              <li>How does "Is anything too hard for the LORD?" apply to your life?</li>
              <li>What does the binding of Isaac teach us about covenant faithfulness?</li>
              <li>Where do you see Christ foreshadowed in these chapters?</li>
            </ul>
          </div>
        </div>

        <a
          href={currentWeek.official_url}
          target="_blank"
          rel="noopener"
          class="inline-block mt-5 font-sans text-xs bg-navy border border-gold/30 text-gold/80 hover:text-gold hover:border-gold/60 px-4 py-2 rounded-lg transition-colors"
        >
          Open Official Lesson &rarr;
        </a>
      </div>

      <!-- RIGHT: Companion Snippets -->
      <div class="bg-navy-light rounded-2xl p-6 border border-navy-lighter">
        <p class="font-sans text-xs uppercase tracking-widest text-gold/50 mb-4">What You Might Not Know</p>

        {snippets.length > 0 ? (
          <div class="space-y-4">
            {snippets.map((s: any) => {
              const meta = categoryMeta[s.category] ?? { label: s.category, color: 'bg-navy text-text-muted border-navy-lighter' };
              const href = `/2026/week/${currentWeekNum}#${s.deep_dive_anchor}`;
              return (
                <a href={href} class="block group">
                  <div class="flex items-start gap-3">
                    <span class={`mt-0.5 shrink-0 font-sans text-[10px] font-semibold uppercase tracking-wider border px-1.5 py-0.5 rounded ${meta.color}`}>
                      {meta.label}
                    </span>
                    <div>
                      <p class="font-sans text-xs text-text-muted mb-0.5">{s.verse_reference}</p>
                      <p class="text-sm text-text/80 leading-relaxed group-hover:text-text transition-colors">{s.snippet_text}</p>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        ) : (
          <p class="text-text-muted text-sm font-sans">Companion insights are being generated...</p>
        )}
      </div>
    </div>

    <!-- Deep Dive CTA -->
    <div class="mt-6 text-center">
      <a
        href={`/2026/week/${currentWeekNum}`}
        class="inline-block font-sans bg-gold text-navy font-semibold px-8 py-3 rounded-lg hover:bg-gold-light transition-colors text-sm tracking-wide"
      >
        Read the Full Deep Dive — 167 Verses &rarr;
      </a>
    </div>
  </div>

  <!-- ── ALL WEEKS SCHEDULE ── -->
  <div>
    <div class="flex items-center gap-4 mb-6">
      <h2 class="font-sans text-xl font-bold text-gold">2026 Schedule</h2>
      <div class="flex-1 h-px bg-navy-lighter"></div>
      <p class="font-sans text-xs text-text-muted">Old Testament — Come, Follow Me</p>
    </div>

    <div class="grid gap-2">
      {otherWeeks.map((w: any) => {
        const isPast = w.date_end < today;
        const isUpcoming = w.date_start > today;
        const content = hasContent(w);

        return (
          <div class={`flex items-center gap-4 px-4 py-3 rounded-xl border transition-colors ${
            content
              ? 'border-navy-lighter bg-navy-light hover:border-gold/30 cursor-pointer'
              : isPast
              ? 'border-navy-lighter/50 bg-navy/30 opacity-60'
              : 'border-navy-lighter/60 bg-navy/20'
          }`}>
            <span class={`font-sans text-xs font-bold shrink-0 w-10 text-center ${content ? 'text-gold' : 'text-text-muted'}`}>
              W{w.week}
            </span>
            <div class="flex-1 min-w-0">
              {content ? (
                <a href={`/2026/week/${w.week}`} class="block group">
                  <p class="font-sans text-sm font-semibold text-text group-hover:text-gold transition-colors truncate">{w.title}</p>
                  <p class="font-sans text-xs text-text-muted truncate">{w.scripture_block}</p>
                </a>
              ) : (
                <div>
                  <p class="font-sans text-sm font-semibold text-text/60 truncate">{w.title}</p>
                  <p class="font-sans text-xs text-text-muted truncate">{w.scripture_block}</p>
                </div>
              )}
            </div>
            <span class="font-sans text-xs text-text-muted shrink-0 hidden sm:block">{w.date_start.slice(5)}</span>
            {content && (
              <span class="font-sans text-[10px] text-gold/70 border border-gold/30 px-2 py-0.5 rounded-full shrink-0">Live</span>
            )}
          </div>
        );
      })}
    </div>
  </div>


<script define:vars={{ hookText, audioUrl }}>
(function () {
  const btn = document.getElementById('audio-play-btn');
  if (!btn) return;

  const iconPlay    = document.getElementById('icon-play');
  const iconPause   = document.getElementById('icon-pause');
  const iconLoading = document.getElementById('icon-loading');
  const label       = document.getElementById('audio-label');
  const mp3         = document.getElementById('hook-audio');

  let playing = false;
  let utterance = null;

  function setIcon(state) {
    iconPlay.classList.toggle('hidden', state !== 'play');
    iconPause.classList.toggle('hidden', state !== 'pause');
    iconLoading.classList.toggle('hidden', state !== 'loading');
    label.textContent = state === 'pause' ? 'Pause' : state === 'loading' ? 'Loading…' : 'Listen';
  }

  function stopAll() {
    if (mp3) { mp3.pause(); mp3.currentTime = 0; }
    if (window.speechSynthesis) window.speechSynthesis.cancel();
    playing = false;
    setIcon('play');
  }

  // MP3 path (pre-generated OpenAI TTS)
  if (mp3) {
    mp3.addEventListener('ended', stopAll);
    mp3.addEventListener('error', () => {
      // Fall back to browser TTS if MP3 fails
      startBrowserTTS();
    });
  }

  function startBrowserTTS() {
    if (!window.speechSynthesis || !hookText) return;
    window.speechSynthesis.cancel();
    utterance = new SpeechSynthesisUtterance(hookText);
    utterance.rate = 0.93;
    utterance.pitch = 1.0;

    // Pick the best available English voice
    const voices = window.speechSynthesis.getVoices();
    const preferred = voices.find(v =>
      ['Samantha', 'Karen', 'Serena', 'Moira', 'Victoria'].some(n => v.name.includes(n))
    ) || voices.find(v => v.lang.startsWith('en') && !v.name.toLowerCase().includes('google')) 
      || voices.find(v => v.lang.startsWith('en'));
    if (preferred) utterance.voice = preferred;

    utterance.onstart  = () => { playing = true; setIcon('pause'); };
    utterance.onend    = stopAll;
    utterance.onerror  = stopAll;
    window.speechSynthesis.speak(utterance);
  }

  btn.addEventListener('click', () => {
    if (playing) {
      stopAll();
      return;
    }

    if (mp3 && audioUrl) {
      // Use pre-generated AI audio
      setIcon('loading');
      mp3.play().then(() => {
        playing = true;
        setIcon('pause');
      }).catch(() => {
        startBrowserTTS();
      });
    } else {
      // Browser TTS fallback
      // Voices may not be loaded yet on first click
      if (window.speechSynthesis.getVoices().length === 0) {
        window.speechSynthesis.onvoiceschanged = () => startBrowserTTS();
        window.speechSynthesis.getVoices(); // trigger load
      } else {
        startBrowserTTS();
      }
    }
  });
})();
</script>

</Layout>
