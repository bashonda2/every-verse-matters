---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}
const { title, description = 'Deep Come, Follow Me scripture study — every verse, every week.', wide = false } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Cinzel:wght@400;600&family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style is:global>
    #tagline-row { display: block; }
    #tagline-text { font-size: 11px; }
    @media (min-width: 860px) { #tagline-text { font-size: 15px; white-space: nowrap; } }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- ── HEADER ── -->
  <header style="position:sticky;top:0;z-index:100;backdrop-filter:blur(12px);background:rgba(250,247,242,0.95);" class="dark:bg-opacity-95 transition-colors">

    <!-- Row 1: Wordmark + Nav -->
    <div style="max-width:1200px;margin:0 auto;padding:10px 2rem;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--color-border);">
      <a href="/" style="text-decoration:none;display:flex;flex-direction:column;align-items:flex-start;line-height:1;gap:2px;">
        <span style="font-family:'Cinzel',serif;font-size:12px;font-weight:600;letter-spacing:0.35em;text-transform:uppercase;color:#5c4220;">Every</span>
        <span id="wordmark-main" style="font-family:'Cormorant Garamond',serif;font-weight:600;font-size:26px;color:var(--color-gold);letter-spacing:0.01em;line-height:1.1;position:relative;">
          Verse Matters
          <span style="position:absolute;bottom:-2px;left:0;width:100%;height:1.5px;background:linear-gradient(90deg,var(--color-gold),var(--color-gold-light),transparent);opacity:0.5;display:block;"></span>
        </span>
      </a>
      <nav style="display:flex;align-items:center;gap:1.75rem;">
        <a href="/2026/week/9" style="font-family:'Source Sans 3',sans-serif;font-size:13px;font-weight:500;letter-spacing:0.04em;text-transform:uppercase;color:var(--color-text-muted);text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='var(--color-gold)'" onmouseout="this.style.color='var(--color-text-muted)'">This Week</a>
        <a href="/weeks" style="font-family:'Source Sans 3',sans-serif;font-size:13px;font-weight:500;letter-spacing:0.04em;text-transform:uppercase;color:var(--color-text-muted);text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='var(--color-gold)'" onmouseout="this.style.color='var(--color-text-muted)'">All Weeks</a>
        <a href="/about" style="font-family:'Source Sans 3',sans-serif;font-size:13px;font-weight:500;letter-spacing:0.04em;text-transform:uppercase;color:var(--color-text-muted);text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='var(--color-gold)'" onmouseout="this.style.color='var(--color-text-muted)'">About</a>
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle light/dark mode">
          <span id="theme-icon"></span>
        </button>
      </nav>
    </div>

    <!-- Row 2: Tagline — full width, own dedicated row (all screens) -->
    <div id="tagline-row" style="width:100%;border-bottom:1px solid var(--color-border);">
      <div style="max-width:1200px;margin:0 auto;padding:7px 2rem;">
        <span id="tagline-text" style="font-family:'Source Sans 3',sans-serif;font-weight:800;letter-spacing:0.12em;text-transform:uppercase;color:#5c4220;">Come, Follow Me &mdash; Every scholar &middot; Every insight &middot; Every verse</span>
      </div>
    </div>

  </header>

  <!-- ── MAIN ── -->
  <main class={`flex-1 w-full ${wide ? '' : 'max-w-4xl mx-auto px-4'} py-8`}>
    <slot />
  </main>

  <!-- ── FOOTER ── -->
  <footer style="border-top:1px solid var(--color-border);background:var(--color-cream-dark);padding:2rem;text-align:center;margin-top:2rem;">
    <p style="font-family:'Source Sans 3',sans-serif;font-size:12px;color:var(--color-text-muted);line-height:1.9;max-width:700px;margin:0 auto;">
      EveryVerseMatters.com is an independent study resource and is not affiliated with, endorsed by, or sponsored by The Church of Jesus Christ of Latter-day Saints.
      Come, Follow Me is a trademark of Intellectual Reserve, Inc. Commentary is AI-supported and should be used as a supplemental study aid. Third-party content is linked with attribution; all rights remain with the original creators.
      <br><span style="color:var(--color-gold-muted);">&copy; 2026 EveryVerseMatters.com</span>
    </p>
  </footer>

  <!-- Theme toggle script -->
  <script is:inline>
    (function () {
      const root = document.documentElement;
      const btn  = document.getElementById('theme-toggle');
      const icon = document.getElementById('theme-icon');

      function apply(dark) {
        if (dark) {
          root.classList.add('dark');
          if (icon) icon.textContent = '☀️';
        } else {
          root.classList.remove('dark');
          if (icon) icon.textContent = '🌙';
        }
      }

      const stored = localStorage.getItem('theme');
      apply(stored === 'dark');

      if (btn) {
        btn.addEventListener('click', () => {
          const isDark = root.classList.contains('dark');
          localStorage.setItem('theme', isDark ? 'light' : 'dark');
          apply(!isDark);
        });
      }
    })();
  </script>
</body>
</html>
